apiVersion: nexus.io/v1
kind: NodeSpec
metadata:
  name: nx-c-r01-05
  labels:
    pool: training
spec:
  archetype: compute-gpu
  status: planned
  location: { site: hq, room: dc1, rack: r01, u: 22, pdu: [r01-pdu-a:12, r01-pdu-b:12] }
  cpu:
    model: "AMD Ryzen 9 7950X"
    sockets: 1
    cores: 16
    threads: 32
    numaNodes: 1
    l3CacheMB: 64
    ccxCount: 2
    baseClockGHz: 4.5
    tdpWatts: 170
  memory:
    totalGB: 128
    type: DDR5-5600
    ecc: false
    channels: 2
    speedMTs: 5600
  gpus:
    - index: 0
      model: "NVIDIA GeForce RTX 4090"
      uuid: GPU-00000000-0000-0000-0000-000000000000
      vramGB: 24
      computeCapability: "8.9"
      pcieBusId: "0000:01:00.0"
      pcieGen: 4
      pcieWidth: x8
      numaAffinity: 0
      nvlink: false
      p2pCapable: false
      gpudirectRdma: false
      migCapable: false
      eccSupported: false
      tdpWatts: 450
      powerCapWatts: 320
  nics:
    - name: enp2s0f0np0
      model: "Mellanox ConnectX-5 EN"
      macAddress: "00:11:22:33:44:55"
      speedGbps: 100
      role: cluster
      pcieBusId: "0000:02:00.0"
      pcieWidth: x8
      numaAffinity: 0
      rdma: { capable: true, protocol: RoCEv2, device: mlx5_0 }
      sriov: { capable: true, maxVfs: 8, configuredVfs: 4 }
      switchPort: "r01-leaf-a:eth5"
    - name: eno1
      macAddress: "00:11:22:33:44:56"
      speedGbps: 1
      role: management
  storage:
    - device: /dev/nvme0n1
      model: "Samsung 990 PRO 2TB"
      sizeGB: 2000
      class: consumer-nvme
      plp: false
      role: scratch
      tier: 0
    - device: /dev/nvme1n1
      sizeGB: 256
      class: consumer-nvme
      plp: false
      role: boot
      tier: 0
  firmware:
    bios: "3.10"
    agesa: "1.2.0.2"
    secureBoot: false
    iommu: true
    resizableBar: true
    above4gDecode: true
    wol: true
    vpro: false
    pxeFirst: true
  power:
    psuWatts: 850
    budgetWatts: 700
  notes: "Example seed node — Phase 01 fills in real hardware."
