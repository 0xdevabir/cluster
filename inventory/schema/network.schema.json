{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.io/schema/network.json",
  "title": "NEXUS Network",
  "description": "Phase 03 (Network Fabric Design) — vlans.yaml, ip-plan.yaml, switch-ports.yaml, and switches.yaml all validate against this file, discriminated by `kind`. ARCHITECTURE.md#l2--network-fabric.",
  "oneOf": [
    { "$ref": "#/$defs/VlanMap" },
    { "$ref": "#/$defs/IpPlan" },
    { "$ref": "#/$defs/SwitchPortMap" },
    { "$ref": "#/$defs/SwitchInventory" }
  ],
  "$defs": {
    "VlanMap": {
      "type": "object",
      "required": ["apiVersion", "kind", "vlans"],
      "additionalProperties": false,
      "properties": {
        "apiVersion": { "const": "nexus.io/v1" },
        "kind": { "const": "VlanMap" },
        "vlans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "cidr", "mtu", "purpose", "routable", "tenantAccessible"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "integer", "minimum": 1, "maximum": 4094 },
              "name": { "type": "string" },
              "cidr": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$" },
              "mtu": { "type": "integer", "enum": [1500, 9000] },
              "purpose": { "type": "string" },
              "routable": { "type": "boolean" },
              "tenantAccessible": { "type": "boolean" },
              "lossless": { "type": "boolean" },
              "dscp": { "type": "integer", "minimum": 0, "maximum": 63 },
              "pcp": { "type": "integer", "minimum": 0, "maximum": 7 }
            }
          }
        }
      }
    },
    "IpPlan": {
      "type": "object",
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "additionalProperties": false,
      "properties": {
        "apiVersion": { "const": "nexus.io/v1" },
        "kind": { "const": "IpPlan" },
        "metadata": {
          "type": "object",
          "required": ["cluster", "site"],
          "additionalProperties": false,
          "properties": {
            "cluster": { "type": "string" },
            "site": { "type": "string" }
          }
        },
        "spec": {
          "type": "object",
          "required": ["supernet", "networks", "kubernetes", "bgp", "upstream"],
          "additionalProperties": false,
          "properties": {
            "supernet": { "type": "string" },
            "networks": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["vlan", "cidr", "mtu"],
                "properties": {
                  "vlan": { "type": "integer" },
                  "cidr": { "type": "string" },
                  "gateway": { "type": "string" },
                  "mtu": { "type": "integer" },
                  "dhcp": {
                    "type": "object",
                    "properties": {
                      "enabled": { "type": "boolean" },
                      "range": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 }
                    }
                  },
                  "reservations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["name", "ip"],
                      "properties": {
                        "name": { "type": "string" },
                        "ip": { "type": "string" }
                      }
                    }
                  },
                  "perRack": { "type": "object", "additionalProperties": { "type": "string" } },
                  "dscp": { "type": "integer" },
                  "pcp": { "type": "integer" },
                  "lossless": { "type": "boolean" }
                }
              }
            },
            "kubernetes": {
              "type": "object",
              "required": ["podCidr", "podCidrPerNode", "serviceCidr", "loadBalancerPool", "clusterDns"],
              "additionalProperties": false,
              "properties": {
                "podCidr": { "type": "string" },
                "podCidrPerNode": { "type": "string" },
                "serviceCidr": { "type": "string" },
                "loadBalancerPool": { "type": "string" },
                "clusterDns": { "type": "string" }
              }
            },
            "bgp": {
              "type": "object",
              "required": ["spineAsn", "leafAsnBase", "hostAsnBase", "unnumbered", "ecmpMaxPaths", "gracefulRestart", "bfd"],
              "additionalProperties": false,
              "properties": {
                "spineAsn": { "type": "integer" },
                "leafAsnBase": { "type": "integer" },
                "hostAsnBase": { "type": "integer" },
                "unnumbered": { "type": "boolean" },
                "ecmpMaxPaths": { "type": "integer", "minimum": 1 },
                "gracefulRestart": { "type": "boolean" },
                "bfd": {
                  "type": "object",
                  "required": ["enabled", "intervalMs", "multiplier"],
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "intervalMs": { "type": "integer" },
                    "multiplier": { "type": "integer" }
                  }
                }
              }
            },
            "upstream": {
              "type": "object",
              "required": ["gateway", "dns", "ntp", "natEgress"],
              "additionalProperties": false,
              "properties": {
                "gateway": { "type": "string" },
                "dns": { "type": "array", "items": { "type": "string" } },
                "ntp": { "type": "array", "items": { "type": "string" } },
                "natEgress": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "SwitchPortMap": {
      "type": "object",
      "required": ["apiVersion", "kind", "switches"],
      "additionalProperties": false,
      "properties": {
        "apiVersion": { "const": "nexus.io/v1" },
        "kind": { "const": "SwitchPortMap" },
        "switches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "model", "role", "rack", "mgmtIp", "ports"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "model": { "type": "string" },
              "role": { "enum": ["leaf", "spine", "mgmt"] },
              "rack": { "type": "string" },
              "asn": { "type": "integer" },
              "mgmtIp": { "type": "string" },
              "ports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["port", "type", "status"],
                  "additionalProperties": false,
                  "properties": {
                    "port": { "type": "string" },
                    "peer": { "type": ["string", "null"] },
                    "peerIf": { "type": ["string", "null"] },
                    "speed": { "type": "string" },
                    "media": { "type": ["string", "null"] },
                    "type": { "enum": ["host", "uplink", "mlag-peer", "mgmt-host", "mgmt-infra"] },
                    "status": { "enum": ["cabled", "reserved"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "SwitchInventory": {
      "type": "object",
      "required": ["apiVersion", "kind", "switches"],
      "additionalProperties": false,
      "properties": {
        "apiVersion": { "const": "nexus.io/v1" },
        "kind": { "const": "SwitchInventory" },
        "switches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "model", "role", "rack", "mgmtIp", "portCount", "bufferMB", "status"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "model": { "type": "string" },
              "role": { "enum": ["leaf", "spine", "mgmt"] },
              "rack": { "type": "string" },
              "asn": { "type": "integer" },
              "mgmtIp": { "type": "string" },
              "portCount": { "type": "integer", "minimum": 1 },
              "bufferMB": { "type": "number", "minimum": 0 },
              "mlagPeer": { "type": ["string", "null"] },
              "status": { "enum": ["racked", "planned"] }
            }
          }
        }
      }
    }
  }
}
