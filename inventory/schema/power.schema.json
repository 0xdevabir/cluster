{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.io/schema/power.json",
  "title": "NEXUS Power (CircuitMap | PduMap | PowerBudget)",
  "description": "Phase 02 (Facility, Power & Thermal Design) — inventory/power/*.yaml. One schema covers all three kinds emitted into this directory; `kind` selects the branch. ARCHITECTURE.md#l0--facility-layer.",
  "type": "object",
  "required": ["apiVersion", "kind"],
  "oneOf": [
    { "$ref": "#/$defs/circuitMap" },
    { "$ref": "#/$defs/pduMap" },
    { "$ref": "#/$defs/powerBudget" }
  ],
  "$defs": {
    "circuitMap": {
      "type": "object",
      "required": ["apiVersion", "kind", "circuits"],
      "additionalProperties": false,
      "properties": {
        "apiVersion": { "const": "nexus.io/v1" },
        "kind": { "const": "CircuitMap" },
        "circuits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "rack", "feeds", "voltage", "phases", "breakerAmps", "continuousLoadAmps", "status"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "rack": { "type": "string", "pattern": "^r[0-9]{2}$" },
              "feeds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "voltage": { "type": "integer" },
              "phases": { "enum": [1, 3] },
              "breakerAmps": { "type": "number", "exclusiveMinimum": 0 },
              "receptacle": { "type": "string" },
              "continuousLoadAmps": { "type": "number", "minimum": 0 },
              "status": { "enum": ["designed", "quoted", "installed", "energized"] }
            },
            "allOf": [
              {
                "if": { "properties": { "status": { "const": "designed" } } },
                "then": {
                  "properties": {
                    "continuousLoadAmps": {
                      "description": "NEC 210.20(A): continuous load must be <= 0.80 x breakerAmps. Enforced live (not from this snapshot) by tools/power-budget.py --check."
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "pduMap": {
      "type": "object",
      "required": ["apiVersion", "kind", "pdus"],
      "additionalProperties": false,
      "properties": {
        "apiVersion": { "const": "nexus.io/v1" },
        "kind": { "const": "PduMap" },
        "pdus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "rack", "model", "mgmtIp", "phases", "breakerAmps", "api", "outlets"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "pattern": "^r[0-9]{2}-pdu-[ab]$" },
              "rack": { "type": "string", "pattern": "^r[0-9]{2}$" },
              "model": { "type": "string" },
              "mgmtIp": { "type": "string", "format": "ipv4" },
              "phases": { "enum": [1, 3] },
              "breakerAmps": { "type": "number", "exclusiveMinimum": 0 },
              "api": {
                "type": "object",
                "required": ["type", "credentialRef"],
                "additionalProperties": false,
                "properties": {
                  "type": { "enum": ["snmpv3", "rest", "restjson"] },
                  "credentialRef": { "type": "string", "pattern": "^vault://" }
                }
              },
              "outlets": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "node"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "type": "integer", "minimum": 1 },
                    "node": { "type": ["string", "null"] },
                    "feed": { "enum": ["primary", "failover", "secondary"] },
                    "reserved": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "powerBudget": {
      "type": "object",
      "required": ["apiVersion", "kind", "generatedBy", "nodes", "racks", "facility"],
      "additionalProperties": false,
      "properties": {
        "apiVersion": { "const": "nexus.io/v1" },
        "kind": { "const": "PowerBudget" },
        "generatedBy": { "type": "string" },
        "generatedAt": { "type": "string" },
        "assumptions": { "type": "object" },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "rack", "peakW", "psuDrawW"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "rack": { "type": "string" },
              "gpuW": { "type": "number" },
              "cpuW": { "type": "number" },
              "platformW": { "type": "number" },
              "storageW": { "type": "number" },
              "nicW": { "type": "number" },
              "peakW": { "type": "number" },
              "psuDrawW": { "type": "number" },
              "budgetWatts": { "type": ["number", "null"] }
            }
          }
        },
        "racks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "nodeCount", "nodesW", "infraW", "rackW", "circuits"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "nodeCount": { "type": "integer" },
              "nodesW": { "type": "number" },
              "infraW": { "type": "number" },
              "rackW": { "type": "number" },
              "circuits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "breakerAmps", "continuousLoadAmps", "percentOfDerated"],
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string" },
                    "breakerAmps": { "type": "number" },
                    "continuousLoadAmps": { "type": "number" },
                    "percentOfDerated": { "type": "number" }
                  }
                }
              }
            }
          }
        },
        "facility": {
          "type": "object",
          "required": ["pIT_W", "pue", "pTotal_W", "serviceCurrentA"],
          "additionalProperties": false,
          "properties": {
            "pIT_W": { "type": "number" },
            "pue": { "type": "number" },
            "pTotal_W": { "type": "number" },
            "serviceCurrentA": { "type": "number" },
            "coolingTons": { "type": "number" },
            "coolingCfm": { "type": "number" }
          }
        }
      }
    }
  }
}
