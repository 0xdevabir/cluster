{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.io/schema/rack.json",
  "title": "NEXUS RackMap",
  "description": "Phase 02 (Facility, Power & Thermal Design) — rack IDs, U positions, and thermal zones. ARCHITECTURE.md#l0--facility-layer.",
  "type": "object",
  "required": ["apiVersion", "kind", "racks"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "nexus.io/v1" },
    "kind": { "const": "RackMap" },
    "racks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "site", "room", "units", "status", "thermalZone", "circuits", "pdus"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^r[0-9]{2}$" },
          "site": { "type": "string" },
          "room": { "type": "string" },
          "units": { "type": "integer", "minimum": 1, "maximum": 60 },
          "status": { "enum": ["planned", "active", "decommissioned"] },
          "thermalZone": { "type": "string" },
          "coldAisleTempC": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min": { "type": "number" },
              "max": { "type": "number" }
            }
          },
          "floorLoadRatingKg": { "type": ["number", "null"] },
          "clearanceFrontM": { "type": "number" },
          "clearanceRearM": { "type": "number" },
          "switches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "role", "u", "powerW"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "role": { "enum": ["leaf", "spine", "mgmt"] },
                "u": { "type": "integer", "minimum": 1 },
                "powerW": { "type": "number", "minimum": 0 }
              }
            }
          },
          "kvm": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "u", "powerW"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "u": { "type": "integer", "minimum": 1 },
                "powerW": { "type": "number", "minimum": 0 }
              }
            }
          },
          "circuits": { "type": "array", "items": { "type": "string" } },
          "pdus": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
